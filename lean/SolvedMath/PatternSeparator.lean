import Init

/-! Separators in consecutive permutation-pattern packing posets.
Positions, ranks, and occurrence indices start at zero. -/

namespace SolvedMath.PatternSeparator

/-- The restriction of `rank` to the first `k` positions is a permutation of those ranks. -/
structure Permutation (k : Nat) where
  rank : Nat → Nat
  bounded : ∀ {i}, i < k → rank i < k
  injective : ∀ {i l}, i < k → l < k → rank i = rank l → i = l
  onto : ∀ {r}, r < k → ∃ i, i < k ∧ rank i = r

/-- A position in one of the prescribed windows of length `k` and stride `d`. -/
def Vertex (k d j x : Nat) : Prop :=
  ∃ t < j, ∃ i < k, x = d*t + i

/-- The strict order generated by the rank comparisons in the prescribed windows. -/
inductive Below {k : Nat} (p : Permutation k) (d j : Nat) : Nat → Nat → Prop
  | window (t i l : Nat) (ht : t < j) (hi : i < k) (hl : l < k)
      (hr : p.rank i < p.rank l) : Below p d j (d*t+i) (d*t+l)
  | trans {x y z} : Below p d j x y → Below p d j y z → Below p d j x z

def Incomparable {k} (p : Permutation k) (d j x y : Nat) : Prop :=
  x ≠ y ∧ ¬ Below p d j x y ∧ ¬ Below p d j y x

/-- The strict lower and upper sets must each contain two incomparable positions. -/
structure IsSeparator {k} (p : Permutation k) (d j z : Nat) : Prop where
  vertex : Vertex k d j z
  compares : ∀ x, Vertex k d j x → x = z ∨ Below p d j x z ∨ Below p d j z x
  lower : ∃ x y, Below p d j x z ∧ Below p d j y z ∧ Incomparable p d j x y
  upper : ∃ x y, Below p d j z x ∧ Below p d j z y ∧ Incomparable p d j x y

/-- Largest weight of an eligible anchor, using zero for an empty set. -/
private def envelope (key weight : Nat → Nat) (r : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => max (envelope key weight r n) (if key n ≤ r then weight n else 0)

private theorem envelope_le {key weight : Nat → Nat} {r n b : Nat}
    (hb : ∀ i < n, key i ≤ r → weight i ≤ b) : envelope key weight r n ≤ b := by
  induction n with
  | zero => simp [envelope]
  | succ n ih =>
    simp only [envelope, Nat.max_le]
    exact ⟨ih (fun i hi => hb i (by omega)), by
      split
      · exact hb n (by omega) ‹_›
      · omega⟩

private theorem le_envelope {key weight : Nat → Nat} {r n i : Nat}
    (hi : i < n) (hr : key i ≤ r) : weight i ≤ envelope key weight r n := by
  induction n with
  | zero => omega
  | succ n ih =>
    by_cases h : i = n
    · subst i
      simpa only [envelope, ite_eq_left hr] using Nat.le_max_right (envelope key weight r n) (weight n)
    · exact Nat.le_trans (ih (by omega)) (Nat.le_max_left ..)

private theorem envelope_mono {key weight : Nat → Nat} {r s n : Nat}
    (h : r ≤ s) : envelope key weight r n ≤ envelope key weight s n :=
  envelope_le fun _ hi hr => le_envelope hi (Nat.le_trans hr h)

private theorem envelope_at {key weight : Nat → Nat} {i r n : Nat}
    (hi : i < n) (eligible : key i ≤ r)
    (last : ∀ q < n, key q ≤ r → weight q ≤ weight i) :
    envelope key weight r n = weight i :=
  Nat.le_antisymm (envelope_le last) (le_envelope hi eligible)

/-- End conditions for an arbitrary overlap size. Both boundary rank sequences increase.
A gap after the same boundary index has room for an interior rank on both sides. -/
structure SeparatedOverlap {k} (p : Permutation k) (m d g : Nat) : Prop where
  length_eq : k = d + m
  disjoint : m ≤ d
  gap_index : g+1 < m
  minimum : p.rank 0 = 0
  prefix_inc : ∀ {i l}, l < m → i < l → p.rank i < p.rank l
  suffix_inc : ∀ {i l}, l < m → i < l → p.rank (d+i) < p.rank (d+l)
  separated : p.rank (m-1) < p.rank d
  prefix_gap : p.rank g + 1 < p.rank (g+1)
  suffix_gap : p.rank (d+g) + 1 < p.rank (d+(g+1))

namespace SeparatedOverlap

variable {k m d g : Nat} {p : Permutation k} (H : SeparatedOverlap p m d g)
include H

private theorem prefix_le {i l : Nat} (hi : i ≤ l) (hl : l < m) :
    p.rank i ≤ p.rank l := by
  rcases Nat.eq_or_lt_of_le hi with rfl | h
  · omega
  · exact Nat.le_of_lt (H.prefix_inc hl h)

private theorem suffix_le {i l : Nat} (hi : i ≤ l) (hl : l < m) :
    p.rank (d+i) ≤ p.rank (d+l) := by
  rcases Nat.eq_or_lt_of_le hi with rfl | h
  · omega
  · exact Nat.le_of_lt (H.suffix_inc hl h)

private theorem prefix_small {i : Nat} (hi : i < m) : p.rank i < p.rank d := by
  have hm := H.gap_index
  exact Nat.lt_of_le_of_lt (H.prefix_le (by omega : i ≤ m-1) (by omega)) H.separated

private theorem suffix_large {i : Nat} (hi : i < m) : p.rank d ≤ p.rank (d+i) := by
  simpa using H.suffix_le (Nat.zero_le i) hi

/-- At a prefix anchor the extra height is the matching suffix rank, and conversely.
The offset between copies leaves room for all ranks outside the overlap. -/
private def stretch (p : Permutation k) (m d r : Nat) : Nat :=
  if r < p.rank d then
    r + envelope p.rank (fun i => p.rank (d+i)) r m
  else
    2*k + r + envelope (fun i => p.rank (d+i)) p.rank r m

private theorem stretch_increases {r s : Nat} (hrs : r < s) (hs : s < k) :
    stretch p m d r < stretch p m d s := by
  have hlen := H.length_eq
  have hlow := envelope_mono (key := p.rank) (weight := fun i => p.rank (d+i)) (n := m)
    (Nat.le_of_lt hrs)
  have hhigh := envelope_mono (key := fun i => p.rank (d+i)) (weight := p.rank) (n := m)
    (Nat.le_of_lt hrs)
  have hbound : envelope p.rank (fun i => p.rank (d+i)) r m ≤ k :=
    envelope_le fun i hi _ => Nat.le_of_lt (p.bounded (by omega : d+i < k))
  unfold stretch
  split <;> split <;> omega

private theorem prefix_anchor {i r : Nat} (hi : i < m) (hlo : p.rank i ≤ r)
    (hstop : ∀ q < m, i < q → r < p.rank q) (hsmall : r < p.rank d) :
    stretch p m d r = r + p.rank (d+i) := by
  simp only [stretch, ite_eq_left hsmall]
  rw [envelope_at (key := p.rank) (weight := fun q => p.rank (d+q)) hi hlo (fun q hq hr => H.suffix_le (by
    by_cases h : q ≤ i
    · exact h
    · have := hstop q hq (by omega)
      omega) hi)]

private theorem suffix_anchor {i r : Nat} (hi : i < m) (hlo : p.rank (d+i) ≤ r)
    (hstop : ∀ q < m, i < q → r < p.rank (d+q)) :
    stretch p m d r = 2*k + r + p.rank i := by
  have hbig := Nat.le_trans (H.suffix_large hi) hlo
  simp only [stretch, ite_eq_right (Nat.not_lt_of_ge hbig)]
  rw [envelope_at (key := fun q => p.rank (d+q)) (weight := p.rank) hi hlo (fun q hq hr => H.prefix_le (by
    by_cases h : q ≤ i
    · exact h
    · have := hstop q hq (by omega)
      omega) hi)]

private theorem aligned {i : Nat} (hi : i < m) :
    stretch p m d (p.rank (d+i)) = 2*k + stretch p m d (p.rank i) := by
  rw [H.suffix_anchor hi (Nat.le_refl _) (fun _ hq h => H.suffix_inc hq h),
      H.prefix_anchor hi (Nat.le_refl _) (fun _ hq h => H.prefix_inc hq h) (H.prefix_small hi)]
  omega

private theorem aligned_gap :
    stretch p m d (p.rank (d+g)+1) = 2*k + stretch p m d (p.rank g+1) := by
  have hg := H.gap_index
  have pre := H.prefix_gap
  have suf := H.suffix_gap
  have hsmall := H.prefix_small hg
  rw [H.suffix_anchor (by omega : g < m) (by omega) (fun q hq h => by
        have := H.suffix_le (by omega : g+1 ≤ q) hq
        omega),
      H.prefix_anchor (by omega : g < m) (by omega) (fun q hq h => by
        have := H.prefix_le (by omega : g+1 ≤ q) hq
        omega) (by omega)]
  omega

/-- Height of a physical position, independent of which occurrence represents it. -/
private def height (p : Permutation k) (m d x : Nat) : Nat :=
  (x/d)*(2*k) + stretch p m d (p.rank (x%d))

private theorem height_window (t : Nat) {i : Nat} (hi : i < k) :
    height p m d (d*t+i) = t*(2*k) + stretch p m d (p.rank i) := by
  have hlen := H.length_eq
  have hdis := H.disjoint
  have hg := H.gap_index
  have hd : 0 < d := by omega
  unfold height
  by_cases h : i < d
  · simp [Nat.mul_add_div hd, Nat.div_eq_of_lt h, Nat.mod_eq_of_lt h]
  · obtain ⟨l, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_gt h)
    have hl : l < m := by omega
    have hld : l < d := by omega
    rw [← Nat.add_assoc, ← Nat.mul_succ, Nat.mul_add_div hd, Nat.div_eq_of_lt hld,
        Nat.add_zero, Nat.mul_add_mod, Nat.mod_eq_of_lt hld, H.aligned hl, Nat.succ_mul]
    omega

private theorem height_strict {j x y : Nat} (h : Below p d j x y) :
    height p m d x < height p m d y := by
  induction h with
  | window t i l _ hi hl hr =>
    rw [H.height_window t hi, H.height_window t hl]
    exact Nat.add_lt_add_left (H.stretch_increases hr (p.bounded hl)) _
  | trans _ _ xy yz => exact Nat.lt_trans xy yz

/-- No directed path in these stacks can return to its starting position. -/
theorem irreflexive {j x : Nat} : ¬ Below p d j x x := by
  intro path
  exact Nat.lt_irrefl _ (H.height_strict path)

/-- Each occupied gap gives two incomparable vertices between the same shared anchors. -/
private theorem gap_pair {j : Nat} (t : Nat) (ht : t+1 < j) :
    ∃ x y, Below p d j x (d*(t+1)+(g+1)) ∧ Below p d j y (d*(t+1)+(g+1)) ∧
      Below p d j (d*(t+1)+g) x ∧ Below p d j (d*(t+1)+g) y ∧ Incomparable p d j x y := by
  have hm := H.gap_index
  have hk := H.length_eq
  have gd := H.disjoint
  have hg : g < m := by omega
  have pre := H.prefix_gap
  have suf := H.suffix_gap
  have bp := p.bounded (by omega : g+1 < k)
  have bs := p.bounded (by omega : d+(g+1) < k)
  obtain ⟨i, hi, ri⟩ := p.onto (by omega : p.rank (d+g)+1 < k)
  obtain ⟨l, hl, rl⟩ := p.onto (by omega : p.rank g+1 < k)
  have hid : i < d := by
    by_cases h : i < d
    · exact h
    · obtain ⟨q, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_gt h)
      have hq : q < m := by omega
      by_cases hqg : q ≤ g
      · have := H.suffix_le hqg hg
        omega
      · have := H.suffix_le (by omega : g+1 ≤ q) hq
        omega
  refine ⟨d*t+i, d*(t+1)+l, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [Nat.mul_succ, Nat.add_assoc] using
      Below.window (p := p) (d := d) t i (d+(g+1)) (by omega : t < j) hi (by omega) (by omega)
  · exact .window (t+1) l (g+1) ht hl (by omega) (by omega)
  · simpa only [Nat.mul_succ, Nat.add_assoc] using
      Below.window (p := p) (d := d) t (d+g) i (by omega : t < j) (by omega) hi (by omega)
  · exact .window (t+1) g l ht (by omega) hl (by omega)
  · have equal_height : height p m d (d*t+i) = height p m d (d*(t+1)+l) := by
      rw [H.height_window t hi, H.height_window (t+1) hl, ri, rl, H.aligned_gap, Nat.succ_mul t (2*k)]
      omega
    refine ⟨?_, ?_, ?_⟩
    · rw [Nat.mul_succ]
      omega
    · intro edge
      have := H.height_strict edge
      omega
    · intro edge
      have := H.height_strict edge
      omega

omit H

/-- Non-strict comparison of two positions in one occurrence. -/
private theorem window_le {k d j : Nat} (p : Permutation k) (t : Nat) {i l : Nat}
    (ht : t < j) (hi : i < k) (hl : l < k) (hr : p.rank i ≤ p.rank l) :
    d*t+i = d*t+l ∨ Below p d j (d*t+i) (d*t+l) := by
  rcases Nat.eq_or_lt_of_le hr with h | h
  · rw [p.injective hi hl h]
    exact Or.inl rfl
  · exact Or.inr (.window t i l ht hi hl h)

private theorem window_compares {k d j : Nat} (p : Permutation k) (t i l : Nat)
    (ht : t < j) (hi : i < k) (hl : l < k) :
    d*t+i = d*t+l ∨ Below p d j (d*t+i) (d*t+l) ∨ Below p d j (d*t+l) (d*t+i) := by
  by_cases h : p.rank i ≤ p.rank l
  · rcases window_le (d := d) p t ht hi hl h with he | he
    · exact Or.inl he
    · exact Or.inr (Or.inl he)
  · exact Or.inr (Or.inr (.window t l i ht hl hi (by omega)))

include H

/-- From the third occurrence on, even the least element lies above the separator. -/
private theorem minimum_after {j : Nat} (n : Nat) (hn : n+2 < j) :
    Below p d j (d+(m-1)) (d*(n+2)) := by
  have hm := H.gap_index
  have hk := H.length_eq
  have hd := H.disjoint
  induction n with
  | zero =>
    simpa [Nat.mul_succ] using
      Below.window (p := p) (d := d) 1 (m-1) d (by omega : 1 < j) (by omega) (by omega) H.separated
  | succ n ih =>
    apply (ih (by omega)).trans
    have step := Below.window (p := p) (d := d) (n+2) 0 d (by omega : n+2 < j)
      (by omega) (by omega) (H.prefix_small (by omega : 0 < m))
    simpa only [Nat.mul_succ, Nat.add_zero] using step

/-- For any overlap satisfying the shared-gap hypotheses, the last position of
the first window is a separator, for every stack of at least three occurrences. -/
theorem separator {j : Nat} (hj : 3 ≤ j) : IsSeparator p d j (k-1) := by
  have hm := H.gap_index
  have hk := H.length_eq
  have hd := H.disjoint
  have hz : k-1 = d+(m-1) := by omega
  rw [hz]
  constructor
  · exact ⟨0, by omega, d+(m-1), by omega, by simp⟩
  · rintro x ⟨t, ht, i, hi, rfl⟩
    cases t with
    | zero => simpa using window_compares (d := d) p 0 i (d+(m-1)) ht hi (by omega)
    | succ t =>
      cases t with
      | zero => simpa using window_compares (d := d) p 1 i (m-1) ht hi (by omega)
      | succ n =>
        have hmin := H.minimum_after n ht
        have hr : p.rank 0 ≤ p.rank i := by
          rw [H.minimum]
          exact Nat.zero_le _
        rcases window_le (d := d) p (n+2) ht (by omega) hi hr with h | h
        · rw [Nat.add_zero] at h
          exact Or.inr (Or.inr (h ▸ hmin))
        · exact Or.inr (Or.inr (hmin.trans (by simpa using h)))
  · obtain ⟨x, y, hx, hy, _, _, apart⟩ := H.gap_pair 0 (by omega : 0+1 < j)
    have hr := H.prefix_le (by omega : g+1 ≤ m-1) (by omega)
    have above := window_le (d := d) p 1 (by omega : 1 < j) (by omega) (by omega) hr
    simp only [Nat.zero_add, Nat.mul_one] at hx hy above
    rcases above with he | he
    · exact ⟨x, y, he ▸ hx, he ▸ hy, apart⟩
    · exact ⟨x, y, hx.trans he, hy.trans he, apart⟩
  · obtain ⟨x, y, _, _, hx, hy, apart⟩ := H.gap_pair 1 (by omega : 1+1 < j)
    have hr := Nat.lt_of_lt_of_le H.separated (H.suffix_large (by omega : g < m))
    have step := Below.window (p := p) (d := d) 1 (m-1) (d+g) (by omega : 1 < j)
      (by omega) (by omega) hr
    have h : Below p d j (d+(m-1)) (d*(1+1)+g) := by
      simpa [Nat.mul_succ, Nat.add_assoc] using step
    exact ⟨x, y, h.trans hx, h.trans hy, apart⟩

end SeparatedOverlap

/-- Part I, §7, item 5. The ranks a,b,c and length k use the paper's one-based
convention. The position labelled k in the paper is k-1 in our indexing. -/
theorem bks_overlap_two_separator {k a b c j : Nat} (p : Permutation k)
    (ha : 2 < a) (hab : a < b) (hbc : b < c-1) (hck : c-1 < k-2) (hj : 2 < j)
    (first : p.rank 0 + 1 = 1) (second : p.rank 1 + 1 = a)
    (penultimate : p.rank (k-2) + 1 = b) (last : p.rank (k-1) + 1 = c) :
    IsSeparator p (k-2) j (k-1) := by
  have hk1 : k-2+1 = k-1 := by omega
  have H : SeparatedOverlap p 2 (k-2) 0 := by
    constructor
    · omega
    · omega
    · decide
    · omega
    · intro i l hl hil
      have ei : i = 0 := by omega
      have el : l = 1 := by omega
      rw [ei, el]
      omega
    · intro i l hl hil
      have ei : i = 0 := by omega
      have el : l = 1 := by omega
      rw [ei, el, Nat.add_zero, hk1]
      omega
    · change p.rank 1 < p.rank (k-2)
      omega
    · change p.rank 0 + 1 < p.rank 1
      omega
    · simp only [Nat.add_zero, Nat.zero_add, hk1]
      omega
  exact H.separator hj

end SolvedMath.PatternSeparator
